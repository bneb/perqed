# ==============================================================================
# PERQED v2.2 ENGINE CONFIGURATION (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT & COMPUTE PATHS
# ------------------------------------------------------------------------------
PERQED_ENV=production
PERQED_LOG_LEVEL=info
PERQED_WORKSPACE_DIR="./workspace"
PERQED_LEDGER_PATH="./.perqed_ledger/ledger.jsonl"
PERQED_DEADENDS_DB="./.perqed_deadends.jsonl"

# Lean 4 & Lake toolchain
LEAN_SYSROOT="/root/.elan/toolchains/leanprover--lean4---v4.16.0"
MATHLIB_DIR="./mathlib4"
LEAN_SERVER_WORKERS=8
LEAN_TIMEOUT_MS=15000

# Sandboxed execution (gVisor / Firejail)
SANDBOX_BACKEND="gvisor" # options: gvisor, firejail, cgroups_v2
SANDBOX_MAX_CPU_SECS=10
SANDBOX_MAX_MEM_MB=512

# ------------------------------------------------------------------------------
# TIER 1: HIGH-THROUGHPUT TACTIC & SUBGOAL PROVER (90% of Calls)
# Local or dedicated vLLM / TensorRT-LLM endpoints (OpenAI-compatible)
# ------------------------------------------------------------------------------
# Options: unsloth/DeepSeek-V4-Prover, Goedel-Prover-V2-32B, Qwen-3.8-Math-72B
TIER1_PROVIDER="vllm"
TIER1_BASE_URL="http://localhost:8000/v1"
TIER1_API_KEY="sk-local-vllm-token"
TIER1_MODEL="deepseek-ai/DeepSeek-V4-Prover"
TIER1_MAX_CONCURRENCY=64
TIER1_TEMPERATURE=0.4
TIER1_TOP_P=0.95
TIER1_MAX_TOKENS=512

# ------------------------------------------------------------------------------
# TIER 2: HIGH-SPEED REASONER & INVARIANT PROPOSER (9% of Calls)
# Literature ingestion, OEIS matching, sub-lemma isolation
# ------------------------------------------------------------------------------
# Options: gemini-3.7-flash / gemini-3.7-flash-thinking, deepseek-v4-flash, qwen-3.8-math-72b
TIER2_PROVIDER="google" # options: google, deepseek, openrouter
GEMINI_API_KEY="AIzaSy..."
TIER2_MODEL="gemini-3.7-flash"
TIER2_TEMPERATURE=0.2
TIER2_MAX_TOKENS=4096

# Fallback Tier 2 (DeepSeek API)
DEEPSEEK_API_KEY="sk-..."
TIER2_FALLBACK_MODEL="deepseek-v4-flash"

# ------------------------------------------------------------------------------
# TIER 3: ADVERSARIAL "EDITOR 2" & STRATEGIC ESCALATION (1% of Calls)
# Bi-directional semantic diff, hypothesis-stuffing audit, high-level proof sketch
# ------------------------------------------------------------------------------
# Options: gpt-5.6-luna / o3-mini, claude-3-7-sonnet / claude-opus-4
TIER3_PROVIDER="openai" # options: openai, anthropic
OPENAI_API_KEY="sk-proj-..."
TIER3_MODEL="gpt-5.6-luna"
TIER3_MAX_TOKENS=8192

ANTHROPIC_API_KEY="sk-ant-..."
TIER3_FALLBACK_MODEL="claude-3-7-sonnet-20250219"

# ------------------------------------------------------------------------------
# ECONOMIC BUDGET & HARD GUARDS PER THEOREM
# ------------------------------------------------------------------------------
MAX_TOTAL_BUDGET_USD_PER_THEOREM=1.50
MAX_MCTS_EXPANSIONS=2000
MAX_SUBLEMMA_DEPTH=4
