# ==============================================================================
# PERQED v2.2 ENGINE CONFIGURATION (.env) - 2026 EDITION
# ==============================================================================

# ------------------------------------------------------------------------------
# ENVIRONMENT & COMPUTE PATHS
# ------------------------------------------------------------------------------
PERQED_ENV=production
PERQED_LOG_LEVEL=info
PERQED_WORKSPACE_DIR="./workspace"
PERQED_LEDGER_PATH="./.perqed_ledger/ledger.jsonl"
PERQED_DEADENDS_DB="./.perqed_deadends.jsonl"

# Lean 4 & Lake toolchain
LEAN_SYSROOT="/root/.elan/toolchains/leanprover--lean4---v4.16.0"
MATHLIB_DIR="./mathlib4"
LEAN_SERVER_WORKERS=8
LEAN_TIMEOUT_MS=15000

# Sandboxing (gVisor runsc / Firejail)
PERQED_SANDBOX_RUNNER="runsc"
PERQED_SANDBOX_NETWORK="none"
PERQED_SANDBOX_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# TIER 1: HIGH-THROUGHPUT LOCAL TACTIC SWARM (90% of Calls - $0 API Marginal Cost)
# Self-hosted via vLLM / Unsloth (OpenAI-compatible)
# ------------------------------------------------------------------------------
# Option A: Qwen-3.8-27B (Dense, 4-bit quant on 24GB GPU)
# Option B: DeepSeek-V4-Flash-0731 (MoE 13B active via vLLM / Unsloth)
TIER1_PROVIDER="vllm"
TIER1_BASE_URL="http://localhost:8000/v1"
TIER1_API_KEY="sk-local-vllm-token"
TIER1_MODEL="qwen/Qwen3.8-27B"
TIER1_MAX_CONCURRENCY=64
TIER1_TEMPERATURE=0.6
TIER1_TOP_P=0.95
TIER1_MAX_TOKENS=512
TIER1_REASONING_EFFORT="low"   # Prevents Qwen3.8 / DeepSeek overthinking loop on trivial syntactic steps

# ------------------------------------------------------------------------------
# TIER 2: SPEED REASONER & INVARIANT PROPOSER (9% of Calls)
# Ingestion, OEIS Matching, Sub-lemma Isolation
# ------------------------------------------------------------------------------
# Primary: Gemini 3.7 Flash (#1 for 50-page TeX/PDF ingestion & agentic decomp)
TIER2_PROVIDER="google"
GEMINI_API_KEY="AIzaSy..."
TIER2_MODEL="gemini-3.7-flash"
TIER2_TEMPERATURE=0.2
TIER2_MAX_TOKENS=4096

# Fallback Tier 2: GPT-5.6 Luna ($0.20/M tokens) or DeepSeek-V4-Flash Cloud API
OPENAI_API_KEY="sk-proj-..."
TIER2_FALLBACK_MODEL="gpt-5.6-luna"
TIER2_FALLBACK_REASONING="medium"

DEEPSEEK_API_KEY="sk-..."
TIER2_DEEPSEEK_MODEL="deepseek-v4-flash"

# ------------------------------------------------------------------------------
# TIER 3: ADVERSARIAL "EDITOR 2" & STRATEGIC ESCALATION (1% of Calls)
# Bi-directional semantic diff, hypothesis check, master proof plan
# ------------------------------------------------------------------------------
# Primary: GPT-5.6 Sol / Terra ($1.25 / M in, $5.00 / M out)
TIER3_PROVIDER="openai"
TIER3_MODEL="gpt-5.6-sol"
TIER3_REASONING_EFFORT="high"
TIER3_MAX_TOKENS=8192

# Alternative Tier 3: DeepSeek-V4-Pro (1.6T MoE / 49B active) or Claude Fable 5 / Opus 4.8
TIER3_DEEPSEEK_MODEL="deepseek-v4-pro"
ANTHROPIC_API_KEY="sk-ant-..."
TIER3_FALLBACK_MODEL="claude-fable-5"

# ------------------------------------------------------------------------------
# ECONOMIC BUDGET & HARD GUARDS PER THEOREM
# ------------------------------------------------------------------------------
MAX_TOTAL_BUDGET_USD_PER_THEOREM=1.50
MAX_TIER3_ESCALATIONS_PER_THEOREM=2
ENABLE_STRICT_BUDGET_HALT=true
